    "import math\n",
    "a = float(input(\"первая сторона: \"))\n",
    "b = float(input(\"вторая сторона: \"))\n",
    "x = float(input(\"Угол между ними: \"))\n",
    "c = math.sqrt(a**2 + b**2 - 2*a*b*math.cos(math.radians(x)))\n",
    "print(c)"
   ]
